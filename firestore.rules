rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'haroonirfan086@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(val) {
      return val is string && val.size() >= 4 && val.size() <= 128 && val.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReqId(val) {
      return val is string && val.size() >= 20 && val.size() <= 84 && val.matches('^req_[a-zA-Z0-9_\\-]+$');
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || (data[field] is int || data[field] is float);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || (data[field] is bool);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'name', 'identifier', 'email', 'mobile', 'authType',
          'pinEnabled', 'pinHash', 'cnicHash', 'cnicLast4', 'mobileHash',
          'kycStatus', 'kycDuplicateOf', 'blocked',
          'activeDeviceId', 'activeDeviceName', 'activeSessionId',
          'activeDeviceCount', 'sessionVersion', 'lastLoginAt',
          'totalKhataAmount', 'totalPendingAmount', 'customerCount',
          'lastSyncAt', 'lastBackupAt', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && isNonEmptyString(data.name, 120)
        && (data.updatedAt is int || data.updatedAt is float) && data.updatedAt > 0
        && isOptionalString(data, 'identifier', 160)
        && isOptionalString(data, 'email', 160)
        && isOptionalString(data, 'mobile', 40)
        && (!( 'authType' in data ) || data.authType in ['email', 'mobile'])
        && isOptionalBool(data, 'pinEnabled')
        && isOptionalString(data, 'pinHash', 128)
        && isOptionalString(data, 'cnicHash', 64)
        && isOptionalString(data, 'cnicLast4', 8)
        && isOptionalString(data, 'mobileHash', 64)
        && (!( 'kycStatus' in data ) || data.kycStatus in ['none', 'verifying', 'approved', 'duplicate'])
        && isOptionalString(data, 'kycDuplicateOf', 128)
        && isOptionalBool(data, 'blocked')
        && isOptionalString(data, 'activeDeviceId', 128)
        && isOptionalString(data, 'activeDeviceName', 160)
        && isOptionalString(data, 'activeSessionId', 128)
        && isOptionalNumber(data, 'activeDeviceCount')
        && isOptionalNumber(data, 'sessionVersion')
        && isOptionalNumber(data, 'lastLoginAt')
        && isOptionalNumber(data, 'totalKhataAmount')
        && isOptionalNumber(data, 'totalPendingAmount')
        && isOptionalNumber(data, 'customerCount')
        && isOptionalNumber(data, 'lastSyncAt')
        && isOptionalNumber(data, 'lastBackupAt')
        && isOptionalNumber(data, 'createdAt');
    }

    function isOwnerSafeProfileCreate(data) {
      return (!('blocked' in data) || data.blocked == false)
        && (!('kycStatus' in data) || data.kycStatus in ['none', 'verifying', 'duplicate']);
    }

    function isOwnerSafeProfileUpdate(incoming, existing) {
      return (!('blocked' in existing) || existing.blocked == false)
        && (!('blocked' in incoming) || incoming.blocked == false)
        && (
          !('kycStatus' in existing)
          || existing.kycStatus != 'duplicate'
          || (incoming.kycStatus == 'duplicate')
        )
        && (
          !('kycStatus' in existing)
          || existing.kycStatus != 'approved'
          || !('cnicHash' in existing)
          || existing.cnicHash == ''
          || incoming.cnicHash == existing.cnicHash
        );
    }

    function isValidVaultDoc(data, userId, docId) {
      return docId in ['core', 'ledger', 'operations', 'kyc']
        && data.keys().hasAll(['uid', 'docType', 'payloadJson', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'docType', 'payloadJson', 'updatedAt'])
        && data.uid == userId
        && data.docType == docId
        && data.payloadJson is string
        && data.payloadJson.size() >= 2
        && data.payloadJson.size() <= 900000
        && (data.updatedAt is int || data.updatedAt is float) && data.updatedAt > 0;
    }

    function isValidBackupDoc(data, userId, backupId) {
      return isNonEmptyString(backupId, 64)
        && data.keys().hasAll(['uid', 'id', 'kind', 'dateKey', 'payloadJson', 'createdAt'])
        && data.keys().hasOnly(['uid', 'id', 'kind', 'dateKey', 'label', 'payloadJson', 'createdAt'])
        && data.uid == userId
        && data.id == backupId
        && data.kind in ['daily', 'manual']
        && data.dateKey is string
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isOptionalString(data, 'label', 120)
        && data.payloadJson is string
        && data.payloadJson.size() >= 2
        && data.payloadJson.size() <= 900000
        && (data.createdAt is int || data.createdAt is float) && data.createdAt > 0;
    }

    function isValidUserDevice(data, userId, deviceId) {
      return isValidId(deviceId)
        && data.keys().hasAll(['uid', 'deviceId', 'deviceName', 'status', 'isActive', 'approvedAt', 'lastSeenAt'])
        && data.keys().hasOnly([
          'uid', 'deviceId', 'deviceName', 'browserVersion', 'ip', 'location',
          'status', 'isActive', 'sessionId', 'approvedAt', 'lastSeenAt'
        ])
        && data.uid == userId
        && data.deviceId == deviceId
        && isNonEmptyString(data.deviceName, 160)
        && isOptionalString(data, 'browserVersion', 160)
        && isOptionalString(data, 'ip', 64)
        && isOptionalString(data, 'location', 160)
        && data.status in ['approved', 'revoked']
        && data.isActive is bool
        && isOptionalString(data, 'sessionId', 128)
        && (data.approvedAt is int || data.approvedAt is float) && data.approvedAt > 0
        && (data.lastSeenAt is int || data.lastSeenAt is float) && data.lastSeenAt > 0;
    }

    function isValidLoginHistoryEntry(data, userId, entryId) {
      return isValidId(entryId)
        && data.keys().hasAll(['uid', 'id', 'deviceName', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'uid', 'id', 'deviceId', 'deviceName', 'isUnknown',
          'ip', 'location', 'browserVersion', 'status',
          'dateStr', 'timeStr', 'createdAt'
        ])
        && data.uid == userId
        && data.id == entryId
        && isOptionalString(data, 'deviceId', 128)
        && isNonEmptyString(data.deviceName, 160)
        && isOptionalBool(data, 'isUnknown')
        && isOptionalString(data, 'ip', 64)
        && isOptionalString(data, 'location', 160)
        && isOptionalString(data, 'browserVersion', 160)
        && data.status in ['Allowed', 'Blocked']
        && isOptionalString(data, 'dateStr', 32)
        && isOptionalString(data, 'timeStr', 32)
        && (data.createdAt is int || data.createdAt is float) && data.createdAt > 0;
    }

    function isValidDeviceApprovalCreate(data, reqId) {
      return isValidReqId(reqId)
        && data.keys().hasAll([
          'reqId', 'uid', 'deviceId', 'deviceName', 'decision',
          'tokenHash', 'approvalToken', 'createdAt', 'decidedAt'
        ])
        && data.keys().hasOnly([
          'reqId', 'uid', 'deviceId', 'deviceName', 'ip', 'location',
          'browserVersion', 'loginDateTime', 'decision', 'tokenHash',
          'approvalToken', 'createdAt', 'decidedAt'
        ])
        && data.reqId == reqId
        && data.uid == request.auth.uid
        && isValidId(data.deviceId)
        && isNonEmptyString(data.deviceName, 160)
        && isOptionalString(data, 'ip', 64)
        && isOptionalString(data, 'location', 160)
        && isOptionalString(data, 'browserVersion', 160)
        && isOptionalString(data, 'loginDateTime', 100)
        && data.decision == 'pending'
        && data.tokenHash is bytes
        && data.tokenHash.size() == 32
        && data.approvalToken == ''
        && (data.createdAt is int || data.createdAt is float) && data.createdAt > 0
        && data.decidedAt == 0;
    }

    function isValidDeviceApprovalUpdate(data, reqId) {
      return isValidReqId(reqId)
        && data.keys().hasAll([
          'reqId', 'uid', 'deviceId', 'deviceName', 'decision',
          'tokenHash', 'approvalToken', 'createdAt', 'decidedAt'
        ])
        && data.keys().hasOnly([
          'reqId', 'uid', 'deviceId', 'deviceName', 'ip', 'location',
          'browserVersion', 'loginDateTime', 'decision', 'tokenHash',
          'approvalToken', 'createdAt', 'decidedAt'
        ])
        && data.decision in ['allowed', 'denied']
        && data.approvalToken is string
        && data.approvalToken.size() >= 16
        && data.approvalToken.size() <= 128
        && (data.decidedAt is int || data.decidedAt is float) && data.decidedAt > 0;
    }

    function isValidCnicClaim(data, cnicHash) {
      return cnicHash.matches('^[a-f0-9]{64}$')
        && data.keys().hasAll(['cnicHash', 'uid', 'createdAt'])
        && data.keys().hasOnly(['cnicHash', 'uid', 'createdAt'])
        && data.cnicHash == cnicHash
        && data.uid == request.auth.uid
        && (data.createdAt is int || data.createdAt is float) && data.createdAt > 0;
    }

    function isValidMobileClaim(data, mobileHash) {
      return mobileHash.matches('^[a-f0-9]{64}$')
        && data.keys().hasAll(['mobileHash', 'uid', 'createdAt'])
        && data.keys().hasOnly(['mobileHash', 'uid', 'createdAt'])
        && data.mobileHash == mobileHash
        && data.uid == request.auth.uid
        && (data.createdAt is int || data.createdAt is float) && data.createdAt > 0;
    }

    match /deviceApprovalLinks/{reqId} {
      allow get: if isValidReqId(reqId);
      allow list: if false;
      allow create: if isAuthenticated()
        && isValidReqId(reqId)
        && !exists(/databases/$(database)/documents/deviceApprovalLinks/$(reqId))
        && isValidDeviceApprovalCreate(request.resource.data, reqId);
      allow update: if isValidReqId(reqId)
        && isValidDeviceApprovalUpdate(request.resource.data, reqId)
        && resource.data.decision == 'pending'
        && request.resource.data.reqId == resource.data.reqId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.tokenHash == resource.data.tokenHash
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decision', 'decidedAt', 'approvalToken'])
        && hashing.sha256(request.resource.data.approvalToken) == resource.data.tokenHash;
      allow delete: if (isOwner(resource.data.uid) || isAdmin()) && isValidReqId(reqId);
    }

    match /cnicRegistry/{cnicHash} {
      allow get: if isAuthenticated() && cnicHash.matches('^[a-f0-9]{64}$');
      allow list: if isAdmin();
      allow create: if isAuthenticated()
        && !exists(/databases/$(database)/documents/cnicRegistry/$(cnicHash))
        && isValidCnicClaim(request.resource.data, cnicHash);
      allow update: if isAdmin()
        && cnicHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['cnicHash', 'uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['cnicHash', 'uid', 'createdAt'])
        && request.resource.data.cnicHash == cnicHash;
      allow delete: if (isOwner(resource.data.uid) || isAdmin()) && cnicHash.matches('^[a-f0-9]{64}$');
    }

    match /mobileRegistry/{mobileHash} {
      allow get: if isAuthenticated() && mobileHash.matches('^[a-f0-9]{64}$');
      allow list: if isAdmin();
      allow create: if isAuthenticated()
        && !exists(/databases/$(database)/documents/mobileRegistry/$(mobileHash))
        && isValidMobileClaim(request.resource.data, mobileHash);
      allow update: if false;
      allow delete: if (isOwner(resource.data.uid) || isAdmin()) && mobileHash.matches('^[a-f0-9]{64}$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && isValidUserProfile(request.resource.data, userId)
        && (isAdmin() || isOwnerSafeProfileCreate(request.resource.data));
      allow update: if isValidUserProfile(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (
          isAdmin()
          || (isOwner(userId) && isOwnerSafeProfileUpdate(request.resource.data, resource.data))
        );
      allow delete: if isOwner(userId) || isAdmin();

      match /vault/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
          && isValidVaultDoc(request.resource.data, userId, docId);
        allow update: if (isOwner(userId) || isAdmin())
          && isValidVaultDoc(request.resource.data, userId, docId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.docType == resource.data.docType;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /backups/{backupId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && isValidBackupDoc(request.resource.data, userId, backupId);
        allow update: if isOwner(userId)
          && isValidBackupDoc(request.resource.data, userId, backupId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /devices/{deviceId} {
        allow get: if isValidId(deviceId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
          && isValidUserDevice(request.resource.data, userId, deviceId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if (isOwner(userId) || isAdmin())
          && isValidUserDevice(request.resource.data, userId, deviceId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.approvedAt == resource.data.approvedAt;
        allow delete: if isValidId(deviceId) && (isOwner(userId) || isAdmin());
      }

      match /loginHistory/{entryId} {
        allow get: if isValidId(entryId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
          && isValidLoginHistoryEntry(request.resource.data, userId, entryId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isValidId(entryId) && (isOwner(userId) || isAdmin());
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
