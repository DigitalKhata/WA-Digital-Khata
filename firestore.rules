rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'haroonirfan086@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || (data[field] is int || data[field] is float);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || (data[field] is bool);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'name', 'identifier', 'email', 'mobile', 'authType',
          'pinEnabled', 'pinHash', 'cnicHash', 'cnicLast4', 'mobileHash',
          'kycStatus', 'kycDuplicateOf', 'blocked',
          'totalKhataAmount', 'totalPendingAmount', 'customerCount',
          'lastSyncAt', 'lastBackupAt', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && isNonEmptyString(data.name, 120)
        && (data.updatedAt is int || data.updatedAt is float) && data.updatedAt > 0
        && isOptionalString(data, 'identifier', 160)
        && isOptionalString(data, 'email', 160)
        && isOptionalString(data, 'mobile', 40)
        && (!( 'authType' in data ) || data.authType in ['email', 'mobile'])
        && isOptionalBool(data, 'pinEnabled')
        && isOptionalString(data, 'pinHash', 128)
        && isOptionalString(data, 'cnicHash', 64)
        && isOptionalString(data, 'cnicLast4', 8)
        && isOptionalString(data, 'mobileHash', 64)
        && (!( 'kycStatus' in data ) || data.kycStatus in ['none', 'verifying', 'approved', 'duplicate'])
        && isOptionalString(data, 'kycDuplicateOf', 128)
        && isOptionalBool(data, 'blocked')
        && isOptionalNumber(data, 'totalKhataAmount')
        && isOptionalNumber(data, 'totalPendingAmount')
        && isOptionalNumber(data, 'customerCount')
        && isOptionalNumber(data, 'lastSyncAt')
        && isOptionalNumber(data, 'lastBackupAt')
        && isOptionalNumber(data, 'createdAt');
    }

    function isOwnerSafeProfileCreate(data) {
      return (!('blocked' in data) || data.blocked == false)
        && (!('kycStatus' in data) || data.kycStatus in ['none', 'verifying', 'duplicate']);
    }

    function isOwnerSafeProfileUpdate(incoming, existing) {
      return (!('blocked' in existing) || existing.blocked == false)
        && (!('blocked' in incoming) || incoming.blocked == false)
        && (
          !('kycStatus' in existing)
          || existing.kycStatus != 'duplicate'
          || (incoming.kycStatus == 'duplicate')
        )
        && (
          !('kycStatus' in existing)
          || existing.kycStatus != 'approved'
          || !('cnicHash' in existing)
          || existing.cnicHash == ''
          || incoming.cnicHash == existing.cnicHash
        );
    }

    function isValidVaultDoc(data, userId, docId) {
      return docId in ['core', 'ledger', 'operations', 'kyc']
        && data.keys().hasAll(['uid', 'docType', 'payloadJson', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'docType', 'payloadJson', 'updatedAt'])
        && data.uid == userId
        && data.docType == docId
        && data.payloadJson is string
        && data.payloadJson.size() >= 2
        && data.payloadJson.size() <= 900000
        && (data.updatedAt is int || data.updatedAt is float) && data.updatedAt > 0;
    }

    function isValidBackupDoc(data, userId, backupId) {
      return isNonEmptyString(backupId, 64)
        && data.keys().hasAll(['uid', 'id', 'kind', 'dateKey', 'payloadJson', 'createdAt'])
        && data.keys().hasOnly(['uid', 'id', 'kind', 'dateKey', 'label', 'payloadJson', 'createdAt'])
        && data.uid == userId
        && data.id == backupId
        && data.kind in ['daily', 'manual']
        && data.dateKey is string
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isOptionalString(data, 'label', 120)
        && data.payloadJson is string
        && data.payloadJson.size() >= 2
        && data.payloadJson.size() <= 900000
        && (data.createdAt is int || data.createdAt is float) && data.createdAt > 0;
    }

    function isValidCnicClaim(data, cnicHash) {
      return cnicHash.matches('^[a-f0-9]{64}$')
        && data.keys().hasAll(['cnicHash', 'uid', 'createdAt'])
        && data.keys().hasOnly(['cnicHash', 'uid', 'createdAt'])
        && data.cnicHash == cnicHash
        && data.uid == request.auth.uid
        && (data.createdAt is int || data.createdAt is float) && data.createdAt > 0;
    }

    function isValidMobileClaim(data, mobileHash) {
      return mobileHash.matches('^[a-f0-9]{64}$')
        && data.keys().hasAll(['mobileHash', 'uid', 'createdAt'])
        && data.keys().hasOnly(['mobileHash', 'uid', 'createdAt'])
        && data.mobileHash == mobileHash
        && data.uid == request.auth.uid
        && (data.createdAt is int || data.createdAt is float) && data.createdAt > 0;
    }

    match /cnicRegistry/{cnicHash} {
      allow get: if isAuthenticated() && cnicHash.matches('^[a-f0-9]{64}$');
      allow list: if isAdmin();
      allow create: if isAuthenticated()
        && !exists(/databases/$(database)/documents/cnicRegistry/$(cnicHash))
        && isValidCnicClaim(request.resource.data, cnicHash);
      allow update: if isAdmin()
        && cnicHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['cnicHash', 'uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['cnicHash', 'uid', 'createdAt'])
        && request.resource.data.cnicHash == cnicHash;
      allow delete: if (isOwner(resource.data.uid) || isAdmin()) && cnicHash.matches('^[a-f0-9]{64}$');
    }

    match /mobileRegistry/{mobileHash} {
      allow get: if isAuthenticated() && mobileHash.matches('^[a-f0-9]{64}$');
      allow list: if isAdmin();
      allow create: if isAuthenticated()
        && !exists(/databases/$(database)/documents/mobileRegistry/$(mobileHash))
        && isValidMobileClaim(request.resource.data, mobileHash);
      allow update: if false;
      allow delete: if (isOwner(resource.data.uid) || isAdmin()) && mobileHash.matches('^[a-f0-9]{64}$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && isValidUserProfile(request.resource.data, userId)
        && (isAdmin() || isOwnerSafeProfileCreate(request.resource.data));
      allow update: if isValidUserProfile(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (
          isAdmin()
          || (isOwner(userId) && isOwnerSafeProfileUpdate(request.resource.data, resource.data))
        );
      allow delete: if isOwner(userId) || isAdmin();

      match /vault/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
          && isValidVaultDoc(request.resource.data, userId, docId);
        allow update: if (isOwner(userId) || isAdmin())
          && isValidVaultDoc(request.resource.data, userId, docId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.docType == resource.data.docType;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /backups/{backupId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && isValidBackupDoc(request.resource.data, userId, backupId);
        allow update: if isOwner(userId)
          && isValidBackupDoc(request.resource.data, userId, backupId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
